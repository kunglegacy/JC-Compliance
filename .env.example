# =============================================================================
# JCBest Compliance & Staff Accountability System - Environment Variables
# =============================================================================

# Supabase Cloud Database Configuration (Dashboard > Project Settings > API)
# Modern Supabase API Keys (New Format: sb_publishable_... / sb_secret_...)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret Key for backend server actions / admin APIs (Replaces legacy service role key)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
